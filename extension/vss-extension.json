{
  "manifestVersion": 1,
  "id": "toggly-feature-flags",
  "name": "Toggly Feature Flags",
  "version": "2.1.3",
  "publisher": "toggly",
  "description": "Feature flags and progressive delivery for Azure Pipelines — typed tasks, service connection, and a CLI escape hatch",
  "categories": ["Azure Pipelines"],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "tags": [
    "feature flags",
    "feature toggles",
    "deployment",
    "release management",
    "progressive delivery",
    "ci/cd",
    "cli"
  ],
  "icons": {
    "default": "images/extension-icon.png"
  },
  "content": {
    "details": {
      "path": "overview.md"
    }
  },
  "screenshots": [
    {
      "path": "images/screenshots/typed-tasks.png"
    },
    {
      "path": "images/screenshots/cli-escape-hatch.png"
    }
  ],
  "links": {
    "getstarted": {
      "uri": "https://docs.toggly.io/integrations/azure-devops"
    },
    "learn": {
      "uri": "https://docs.toggly.io"
    },
    "support": {
      "uri": "https://toggly.io/support"
    },
    "repository": {
      "uri": "https://github.com/ops-ai/toggly-azure-devops"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/ops-ai/toggly-azure-devops"
  },
  "badges": [
    {
      "href": "https://docs.toggly.io/integrations/azure-devops",
      "uri": "https://img.shields.io/badge/docs-Azure%20DevOps-556EE6",
      "description": "Toggly Azure DevOps docs"
    },
    {
      "href": "https://toggly.io",
      "uri": "https://img.shields.io/badge/Toggly-Feature%20Flags-blue",
      "description": "Toggly Feature Flags"
    }
  ],
  "contributions": [
    {
      "id": "toggly-service-endpoint",
      "description": "Service endpoint type for Toggly connections",
      "type": "ms.vss-endpoint.service-endpoint-type",
      "targets": [
        "ms.vss-endpoint.endpoint-types"
      ],
      "properties": {
        "name": "toggly",
        "displayName": "Toggly Feature Flags",
        "url": {
          "displayName": "Toggly API URL",
          "helpText": "Base URL for the Toggly API (for example https://app.toggly.io/api)."
        },
        "icon": "images/extension-icon.png",
        "authenticationSchemes": [
          {
            "type": "ms.vss-endpoint.endpoint-auth-scheme-basic",
            "inputDescriptors": [
              {
                "id": "username",
                "name": "Client ID",
                "description": "OAuth2 Client ID from Toggly Team Settings > API Credentials",
                "inputMode": "textbox",
                "isConfidential": false,
                "validation": {
                  "isRequired": true,
                  "dataType": "string"
                }
              },
              {
                "id": "password",
                "name": "Client Secret",
                "description": "OAuth2 Client Secret from Toggly Team Settings > API Credentials",
                "inputMode": "passwordbox",
                "isConfidential": true,
                "validation": {
                  "isRequired": true,
                  "dataType": "string"
                }
              }
            ]
          }
        ],
        "helpMarkDown": "<a href=\"https://docs.toggly.io/integrations/azure-devops\" target=\"_blank\"><b>Learn more</b></a>"
      }
    },
    {
      "id": "toggly-create-release-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "tasks/CreateReleaseTask"
      }
    },
    {
      "id": "toggly-associate-build-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "tasks/AssociateBuildTask"
      }
    },
    {
      "id": "toggly-create-feature-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "tasks/CreateFeatureTask"
      }
    },
    {
      "id": "toggly-update-feature-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "tasks/UpdateFeatureTask"
      }
    },
    {
      "id": "toggly-update-feature-env-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "tasks/UpdateFeatureEnvTask"
      }
    },
    {
      "id": "toggly-activate-release-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "tasks/ActivateReleaseTask"
      }
    },
    {
      "id": "toggly-rollback-release-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "tasks/RollbackReleaseTask"
      }
    },
    {
      "id": "toggly-cli-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "tasks/TogglyCLI"
      }
    }
  ],
  "files": [
    {
      "path": "tasks/CreateReleaseTask"
    },
    {
      "path": "tasks/AssociateBuildTask"
    },
    {
      "path": "tasks/CreateFeatureTask"
    },
    {
      "path": "tasks/UpdateFeatureTask"
    },
    {
      "path": "tasks/UpdateFeatureEnvTask"
    },
    {
      "path": "tasks/ActivateReleaseTask"
    },
    {
      "path": "tasks/RollbackReleaseTask"
    },
    {
      "path": "tasks/TogglyCLI"
    },
    {
      "path": "images",
      "addressable": true
    }
  ]
}
