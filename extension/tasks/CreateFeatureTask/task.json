{
  "$schema": "https://raw.githubusercontent.com/Microsoft/azure-pipelines-task-lib/master/tasks.schema.json",
  "id": "5a1d8c37-6e2b-4f90-a3c4-1b7e9d0f5a82",
  "name": "TogglyCreateFeature",
  "friendlyName": "Toggly - Create Feature",
  "description": "Create a new feature flag in Toggly",
  "helpMarkDown": "Creates a new feature flag with specified configuration. [Learn more](https://docs.toggly.io/integrations/azure-devops)",
  "category": "Utility",
  "visibility": [
    "Build",
    "Release"
  ],
  "author": "Toggly",
  "version": {
    "Major": 1,
    "Minor": 0,
    "Patch": 4
  },
  "instanceNameFormat": "Create Feature: $(featureKey)",
  "inputs": [
    {
      "name": "connectedService",
      "type": "connectedService:toggly",
      "label": "Toggly Service Connection",
      "required": true,
      "helpMarkDown": "Select a Toggly service connection"
    },
    {
      "name": "teamId",
      "type": "pickList",
      "label": "Workspace",
      "required": false,
      "properties": {
        "EditableOptions": "True"
      },
      "helpMarkDown": "Select a workspace after choosing a service connection, or type the workspace ID if the list is empty."
    },
    {
      "name": "applicationId",
      "type": "pickList",
      "label": "Application",
      "required": true,
      "properties": {
        "EditableOptions": "True"
      },
      "helpMarkDown": "The Toggly application. Select from the list or type the application ID."
    },
    {
      "name": "featureName",
      "type": "string",
      "label": "Feature Name",
      "required": true,
      "helpMarkDown": "Display name for the feature"
    },
    {
      "name": "featureKey",
      "type": "string",
      "label": "Feature Key",
      "required": true,
      "helpMarkDown": "Unique key used to reference the feature in code"
    },
    {
      "name": "description",
      "type": "multiLine",
      "label": "Description",
      "required": false,
      "helpMarkDown": "Optional description (markdown supported)",
      "properties": {
        "resizable": true,
        "rows": "4"
      }
    },
    {
      "name": "category",
      "type": "string",
      "label": "Category",
      "required": false,
      "helpMarkDown": "Optional category for organizing features"
    },
    {
      "name": "tags",
      "type": "string",
      "label": "Tags",
      "required": false,
      "helpMarkDown": "Comma-separated list of tags (e.g., 'frontend, ui, beta')"
    }
  ],
  "dataSourceBindings": [
    {
      "target": "teamId",
      "endpointId": "$(connectedService)",
      "dataSourceName": "TogglyWorkspaces"
    },
    {
      "target": "applicationId",
      "endpointId": "$(connectedService)",
      "dataSourceName": "TogglyApplications",
      "parameters": {
        "teamId": "$(teamId)"
      }
    }
  ],
  "execution": {
    "Node20_1": {
      "target": "index.js"
    }
  }
}
