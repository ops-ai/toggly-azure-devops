{
  "name": "toggly-azure-devops-extension",
  "version": "2.1.4",
  "description": "Azure DevOps extension for Toggly feature flags, releases, and CLI",
  "main": "index.js",
  "scripts": {
    "build": "tsc && npm run webpack",
    "webpack": "webpack --mode production",
    "package": "tfx extension create --manifest-globs extension/vss-extension.json",
    "publish": "tfx extension publish --manifest-globs extension/vss-extension.json",
    "test": "jest",
    "clean": "rimraf dist"
  },
  "keywords": [
    "azure-devops",
    "feature-flags",
    "toggly",
    "pipeline",
    "extension"
  ],
  "author": "Toggly",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.5",
    "azure-devops-node-api": "^12.5.0",
    "azure-pipelines-task-lib": "^4.10.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/q": "^1.5.8",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "tfx-cli": "^0.22.6",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
