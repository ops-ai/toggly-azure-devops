{
  "id": "toggly-service-endpoint",
  "description": "Service endpoint type for Toggly connections",
  "type": "ms.vss-endpoint.service-endpoint-type",
  "targets": [
    "ms.vss-endpoint.endpoint-types"
  ],
  "properties": {
    "name": "toggly",
    "displayName": "Toggly Feature Flags",
    "url": {
      "displayName": "Toggly API URL",
      "helpText": "Base URL for the Toggly API (for example https://app.toggly.io/api)."
    },
    "icon": "images/extension-icon.png",
    "authenticationSchemes": [
      {
        "type": "ms.vss-endpoint.endpoint-auth-scheme-basic",
        "inputDescriptors": [
          {
            "id": "username",
            "name": "Client ID",
            "description": "OAuth2 Client ID from Toggly Team Settings > API Credentials",
            "inputMode": "textbox",
            "isConfidential": false,
            "validation": {
              "isRequired": true,
              "dataType": "string"
            }
          },
          {
            "id": "password",
            "name": "Client Secret",
            "description": "OAuth2 Client Secret from Toggly Team Settings > API Credentials",
            "inputMode": "passwordbox",
            "isConfidential": true,
            "validation": {
              "isRequired": true,
              "dataType": "string"
            }
          }
        ]
      }
    ],
    "dataSources": [
      {
        "name": "TestConnection",
        "endpointUrl": "{{endpoint.url}}/v2/integrations/azure-devops/workspaces",
        "resultSelector": "jsonpath:$[*].id"
      },
      {
        "name": "TogglyWorkspaces",
        "endpointUrl": "{{endpoint.url}}/v2/integrations/azure-devops/workspaces",
        "resultSelector": "jsonpath:$[*]",
        "resultTemplate": "{\"Value\":\"{{{id}}}\",\"DisplayValue\":\"{{{name}}}\"}"
      },
      {
        "name": "TogglyApplications",
        "endpointUrl": "{{endpoint.url}}/v2/integrations/azure-devops/applications?teamId={{teamId}}",
        "resultSelector": "jsonpath:$[*]",
        "resultTemplate": "{\"Value\":\"{{{id}}}\",\"DisplayValue\":\"{{{name}}}\"}"
      },
      {
        "name": "TogglyEnvironments",
        "endpointUrl": "{{endpoint.url}}/v2/integrations/azure-devops/applications/{{applicationId}}/environments",
        "resultSelector": "jsonpath:$[*]",
        "resultTemplate": "{\"Value\":\"{{{name}}}\",\"DisplayValue\":\"{{{name}}}\"}"
      }
    ],
    "helpMarkDown": "<a href=\"https://docs.toggly.io/integrations/azure-devops\" target=\"_blank\"><b>Learn more</b></a>"
  }
}
